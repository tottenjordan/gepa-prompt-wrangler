# --- GCP Configuration ---
GCP_PROJECT_ID=your-project-id
PROJECT_NUMBER=9999999999
GCP_REGION=us-central1
GCP_STAGING_BUCKET=your-project-id-wrangler-staging

# --- Vertex AI ---
GOOGLE_CLOUD_PROJECT=${GCP_PROJECT_ID}
# MUST be "global" — Gemini 3.x and all Claude models use the global endpoint.
# Only Gemini 2.x uses regional endpoints, and those retire 2026-10-16.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=1

# DO NOT SET GOOGLE_GENAI_USE_ENTERPRISE HERE.
#
# Nothing in wrangler/ reads it, so it buys nothing -- but google-genai treats it
# as a second, independent way of saying "use Vertex". Every child process
# inherits it, so any tool that authenticates with an API key gets
# `401 API keys are not supported by this API`, *even with USE_VERTEXAI unset*.
# It cost three failed figure generations and a wrong diagnosis on 2026-09-09.
# tests/test_env_example.py fails if it reappears below.

# --- PaperBanana (chart rendering) ---
# An AI Studio key: https://aistudio.google.com/apikey
#
# Safe to keep here despite the ADC rule above, because core/config.py reads it
# into PAPERBANANA_API_KEY at import and then *pops* both key vars, so it can
# never reach Vertex. reporting/charts.py hands the stash to the PaperBanana
# subprocess, which talks to the Gemini Developer API where a key is correct.
#
# Leave it out and every report silently renders matplotlib charts instead --
# `PaperBanana skipped (no GOOGLE_API_KEY)` is the only sign. One key is enough;
# GEMINI_API_KEY is only a fallback and setting both is redundant.
GOOGLE_API_KEY=

# --- MCP servers (required for examples/multi_model_agents) ---
# Agent Registry resource names
SEARCH_MCP_SERVER=wrangler-search-mcp
BOOKING_MCP_SERVER=wrangler-booking-mcp
EXPENSE_MCP_SERVER=wrangler-expense-mcp
# Direct Cloud Run URLs used by deployed agents
SEARCH_MCP_URL=https://wrangler-search-mcp-xxxxx.us-central1.run.app/mcp
BOOKING_MCP_URL=https://wrangler-booking-mcp-xxxxx.us-central1.run.app/mcp
EXPENSE_MCP_URL=https://wrangler-expense-mcp-xxxxx.us-central1.run.app/mcp

# --- GEAP deployment (optional) ---
# Warm workers per deployed engine. GEAP routes requests to a worker that has
# not finished booting and that request returns HTTP 200 with zero events, so a
# floor above zero narrows the window — it does not close it, and callers still
# have to retry an empty stream. Billed continuously, and it applies to *every*
# engine a manifest deploys (one per pair), so 2 buys the warm spare without
# multiplying idle spend across a five-pair run. Unset = leave it to GEAP.
GEAP_MIN_INSTANCES=2

# --- BigQuery log sink ---
DATASET_NAME=gepa_wrangler_logs
SINK_NAME=gepa-agent-traces
