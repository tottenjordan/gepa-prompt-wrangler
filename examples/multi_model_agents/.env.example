# GCP Project Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_STAGING_BUCKET=your-project-id-geap-staging
PROJECT_NUMBER=your-project-number
GOOGLE_GENAI_USE_VERTEXAI=1


# BigQuery log sink
DATASET_NAME=gepa_wrangler_logs
SINK_NAME=gepa-agent-traces


# MCP Server URLs (Cloud Run)
SEARCH_MCP_URL=https://wrangler-search-mcp-XXXX-uc.a.run.app/mcp
BOOKING_MCP_URL=https://wrangler-booking-mcp-XXXX-uc.a.run.app/mcp
EXPENSE_MCP_URL=https://wrangler-expense-mcp-XXXX-uc.a.run.app/mcp


# Agent Registry MCP Server Resource Names
SEARCH_MCP_SERVER=projects/PROJECT_NUMBER/locations/us-central1/services/wrangler-search-mcp
BOOKING_MCP_SERVER=projects/PROJECT_NUMBER/locations/us-central1/services/wrangler-booking-mcp
EXPENSE_MCP_SERVER=projects/PROJECT_NUMBER/locations/us-central1/services/wrangler-expense-mcp


# Models
LITE_MODEL=gemini-3.1-flash-lite
FLASH_MODEL=gemini-3.5-flash
PRO_MODEL=gemini-3.1-pro-preview
SONNET_MODEL=claude-sonnet-4-6
OPUS_MODEL=claude-opus-4-6
SIMULATOR_MODEL=gemini-2.5-flash


# Agent Engine IDs (populated after deployment)
LITE_ENGINE_ID=
FLASH_ENGINE_ID=
PRO_ENGINE_ID=
SONNET_ENGINE_ID=
OPUS_ENGINE_ID=
COORDINATOR_AGENT_ID=
ROUTER_ENGINE_ID=
